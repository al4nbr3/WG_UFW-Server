# WG_UFW-Server Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# Claude AI assistant (optional — falls back to manual mode if not set)
ANTHROPIC_API_KEY=sk-ant-api03-...

# WireGuard server settings (override defaults)
WG_INTERFACE=wg0
WG_PORT=51820
WG_SERVER_IP=10.0.0.1
WG_SUBNET=10.0.0.0/24
WG_DNS=1.1.1.1,8.8.8.8

# Server public IP (auto-detected if not set)
# SERVER_PUBLIC_IP=YOUR.PUBLIC.IP.HERE
